{"nodes": [{"id": "sms_sms_do_nil_nil", "label": "Nil", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC cuja mem\u00f3ria degrada entre o fim de maio e 14 de junho de 2003. Acha que o grupo estragou tudo em 2000."}, {"id": "sms_sms_do_nil_sarah", "label": "Sarah", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Namorada de escolinha do Nil, loira de maria-chiquinha, foto e bilhetinhos na gaveta do est\u00fadio. Em junho ele n\u00e3o reconhece o nome."}, {"id": "sms_sms_do_nil_deck", "label": "Deck do Joe", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aparelho de fita que Joe empresta ao Nil. Joe troca a fia\u00e7\u00e3o e p\u00f5e rel\u00e9s; esquenta no peito e, no colapso, queima a pele com cheiro de pl\u00e1stico derretido."}, {"id": "sms_sms_do_nil_degradacao_neuronal", "label": "Degrada\u00e7\u00e3o neuronal", "file_type": "rationale", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "T\u00edtulo do fio, fim de maio de 2003. Nil esquece o bolo dos 10 anos e descreve o vazio como arquivo corrompido, com chiado de r\u00e1dio AM dentro do ouvido. O hamb\u00farguer do Port\u00e3o continua igual ao de tr\u00eas anos antes, enquanto os computadores de 2003 est\u00e3o r\u00e1pidos."}, {"id": "sms_sms_do_nil_carros_hexagono", "label": "Carros de hex\u00e1gono", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carros pretos com hex\u00e1gonos nas portas, lanternas no escuro. Rasgam a fita. Nil diz que levaram tudo."}, {"id": "sms_sms_do_nil_fita_2000", "label": "Fita de 2000", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fita cujo som do ano 2000 vira p\u00f3 quando \u00e9 rasgada. Nil diz que as mem\u00f3rias somem junto com o pl\u00e1stico."}, {"id": "sms_sms_do_nil_colapso_buffer", "label": "Colapso do buffer", "file_type": "rationale", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alerta de caracteres corrompidos seguido da sequ\u00eancia bin\u00e1ria de CORRA. Nil diz que o c\u00e9u virou est\u00e1tica verde, que o grupo caiu no v\u00e1cuo, que 2004 n\u00e3o existe porque n\u00e3o foi programado e que o buffer vai estourar. Pede que venham ao por\u00e3o antes que ele esque\u00e7a quem s\u00e3o."}, {"id": "sms_sms_do_nil_porao", "label": "Por\u00e3o", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ponto de encontro que Nil marca no colapso, enquanto o Deck queima."}, {"id": "sms_sms_do_nil_loop_2003", "label": "Loop at\u00e9 2003", "file_type": "concept", "source_file": "sms/sms do nil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nil vive junho de 2003 e afirma que o ano 2004 n\u00e3o foi programado."}], "edges": [{"source": "sms_sms_do_nil_nil", "target": "sms_sms_do_nil_degradacao_neuronal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sms/sms do nil.md", "source_location": null, "weight": 1.0}, {"source": "sms_sms_do_nil_nil", "target": "sms_sms_do_nil_sarah", "relation": "conceptually_related_to", "confidence": 