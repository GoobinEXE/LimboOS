{"nodes": [{"id": "sms_sms_bocao_bocao", "label": "Boc\u00e3o", "file_type": "concept", "source_file": "sms/sms bocao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC da oficina de fliperama. Em 2003 prefere PS2, pastel e Swallow Rest confort\u00e1vel a voltar para a chuva de 2000."}, {"id": "sms_sms_bocao_swallow_rest", "label": "Swallow Rest", "file_type": "concept", "source_file": "sms/sms bocao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cidade de onde Boc\u00e3o n\u00e3o quer voltar: frio e chuva em 2000, oficina e feira em 2003."}, {"id": "sms_sms_bocao_fenda", "label": "Fenda", "file_type": "concept", "source_file": "sms/sms bocao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rachadura que Boc\u00e3o recusa revisitar e que, no por\u00e3o, ele acredita sugar a rede el\u00e9trica."}, {"id": "sms_sms_bocao_byte_haven", "label": "Byte Haven", "file_type": "concept", "source_file": "sms/sms bocao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oficina de fliperama do Boc\u00e3o. O rel\u00f3gio de luz gira mesmo com os disjuntores desligados."}, {"id": "sms_sms_bocao_loop_2003", "label": "Loop de 2003", "file_type": "concept", "source_file": "sms/sms bocao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ano em que o grupo est\u00e1. Boc\u00e3o trata 2003 como para\u00edso de pe\u00e7as baratas e n\u00e3o quer retornar a 2000."}, {"id": "sms_sms_bocao_rejeicao_silicio", "label": "Rejei\u00e7\u00e3o do sil\u00edcio", "file_type": "rationale", "source_file": "sms/sms bocao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dad