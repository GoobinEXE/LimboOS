{"nodes": [{"id": "readme_limboos", "label": "LimboOS", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Companion de campanha de RPG de mesa. N\u00e3o \u00e9 um sistema operacional: \u00e9 o objeto dieg\u00e9tico que o agente usa enquanto a hist\u00f3ria acontece."}, {"id": "readme_limbo", "label": "Limbo", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lugar das mem\u00f3rias esquecidas. N\u00e3o \u00e9 inferno nem para\u00edso: \u00e9 um intervalo, uma dobra no tempo onde o que foi apagado ainda ecoa."}, {"id": "readme_fenda", "label": "Fenda", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rachadura. Em algumas campanhas abre na virada do mil\u00eanio. O Bug do Ano 2000, na lore, n\u00e3o destruiu o mundo de fora: abriu uma porta para dentro das lembran\u00e7as."}, {"id": "readme_y2k", "label": "Bug do Ano 2000", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Na lore, o Y2K abre a fenda em vez de destruir o mundo exterior."}, {"id": "readme_swallow_rest", "label": "Swallow Rest", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cidade das campanhas Last Rewind e Side B, entre o fim dos anos 90 e 2003."}, {"id": "readme_polarized", "label": "Polarized", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nome de lugar que alimenta a atmosfera do Limbo, ao lado de Swallow Rest e Ashfield Springs."}, {"id": "readme_ashfield_springs", "label": "Ashfield Springs", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nome de lugar que alimenta a atmosfera do Limbo."}, {"id": "readme_intel", "label": "Intel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intelig\u00eancia de campo colet\u00e1vel: \u00e1udio, texto, imagem e meta, muitas vezes com n\u00edvel de sigilo. Desbloquear avan\u00e7a o dossi\u00ea do agente."}, {"id": "readme_intel_audio", "label": "Intel de \u00e1udio", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fitas, grava\u00e7\u00f5es, vozes e ru\u00eddos."}, {"id": "readme_intel_text", "label": "Intel de texto", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relat\u00f3rios, recados, fragmentos e di\u00e1logos."}, {"id": "readme_intel_visual", "label": "Intel visual", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fotos, imagens e evid\u00eancias."}, {"id": "readme_intel_meta", "label": "Intel meta", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pe\u00e7as especiais da trama. V\u00eddeo e mapas vivos ficam no horizonte."}, {"id": "readme_sigilo", "label": "N\u00edvel de sigilo", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada item pode ir do restrito ao top secret."}, {"id": "readme_agente", "label": "Agente", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personagem do jogador. O jogador n\u00e3o entra como usu\u00e1rio gen\u00e9rico: assume o agente."}, {"id": "readme_mestre", "label": "Mestre", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operador da mesa. N\u00e3o administra um site: opera o sistema que os agentes acreditam ser real."}, {"id": "readme_walkman", "label": "Walkman", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aparelho das campanhas de fita e mem\u00f3ria. Em Last Rewind \u00e9 a chave emocional da d\u00e9cada, n\u00e3o um acess\u00f3rio."}, {"id": "readme_nokia", "label": "Nokia", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Celular de teclado f\u00edsico. Em Last Rewind: Side B, ano 2003, vira companheiro de contagem regressiva, SMS e alertas."}, {"id": "readme_last_rewind", "label": "Last Rewind", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanha em Swallow Rest, 1999\u20132000, no Walkman, centrada na fenda Y2K."}, {"id": "readme_last_rewind_side_b", "label": "Last Rewind: Side B", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanha em Swallow Rest, 2003, no Nokia. Contagem regressiva; a sa\u00edda narrada \u00e9 voltar ao ponto zero."}, {"id": "readme_neo_sampa_2099", "label": "Neo-Sampa 2099", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanha no Setor 011, S\u00e3o Paulo: neon e resist\u00eancia."}, {"id": "readme_estacao_orbital_zero", "label": "Esta\u00e7\u00e3o Orbital Zero", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanha em \u00f3rbita baixa, 2105: elite e segredos."}, {"id": "readme_the_retro_grid", "label": "The Retro Grid", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanha no cyber-espa\u00e7o de 1984: simula\u00e7\u00e3o e v\u00edrus."}, {"id": "readme_zona_morta_arizona", "label": "Zona Morta: Arizona", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanha no deserto em 2097. Est\u00e1 bloqueada por enquanto."}, {"id": "readme_campaign_lifecycle", "label": "Ciclo de vida da campanha", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campanhas podem estar ativas, arquivadas ou bloqueadas. O mestre abre a porta quando a mesa est\u00e1 pronta."}, {"id": "readme_bios", "label": "BIOS / Terminal", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mini-experi\u00eancia de estar por baixo do sistema, digitando no escuro."}, {"id": "readme_limbo_board", "label": "Limbo Board / BBS", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quadro de mensagens secreto, ecos de quem passou."}, {"id": "readme_disk_repair", "label": "Reparo de disco", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consertar o que est\u00e1 corrompido \u00e9 narrativa, n\u00e3o s\u00f3 puzzle."}, {"id": "readme_win95_macos", "label": "Windows 95 / Mac OS", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktops fantasmas: o passado digital como cen\u00e1rio."}, {"id": "readme_npc_sms", "label": "SMS de NPCs", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joe, Mai, Nil, Boc\u00e3o e Jaden falam como gente da cidade. O diret\u00f3rio sms/ entra no que a licen\u00e7a do c\u00f3digo n\u00e3o cobre."}, {"id": "readme_terminal_arg", "label": "Terminal ARG", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canto lateral da fic\u00e7\u00e3o, para quem fu\u00e7a demais."}, {"id": "readme_agent_journey", "label": "Jornada do agente", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entrar, assumir o personagem, escolher a campanha, pegar o dispositivo, consumir Intel e abrir o que estava fechado."}, {"id": "readme_achievements", "label": "Conquistas", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marcas mec\u00e2nicas, de lore ou entregues pelo mestre. IDs no README: ACH-FIRST Primeiro Contato, ACH-THREE Colecionador, ACH-FIVE Arquivista, ACH-ALL Biblioteca Completa, ACH-FULL-LISTEN Fim da Fita, ACH-BIOS-BOOT POST Completo, ACH-WIN95-BOOT Plug and Play, ACH-OS-TRIPLE Trindade de Interfaces, ACH-REPAIR-SUCCESS A Verdade no Zero, ACH-REPAIR-APP, ACH-LIMBO-FOUND Despertar, ACH-LIMBO-READ O Ponto Zero, ACH-SECRET Voc\u00ea N\u00e3o Deveria Estar Aqui, ACH-SB-SIGNAL, ACH-LORE-ANALOG Viajante Anal\u00f3gico, ACH-VETERAN Veterano, ACH-MECH-MARRETA Marreta."}, {"id": "readme_progress_model", "label": "Progresso no personagem", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O progresso fica amarrado ao personagem, n\u00e3o s\u00f3 \u00e0 conta: conta, agente, intel e conquistas. Cada pessoa na mesa tem o pr\u00f3prio dossi\u00ea."}, {"id": "readme_admin_panel", "label": "Painel do mestre", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frentes Ao vivo, Mesa, Miss\u00f5es, Conte\u00fado e Sistema. A pista sai no segundo em que o sil\u00eancio da mesa pede pista."}, {"id": "readme_anachronistic_aesthetic", "label": "Est\u00e9tica anacr\u00f4nica", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walkman, Nokia, BIOS, Windows 95 e Mac s\u00e3o deliberados. O charme est\u00e1 no ru\u00eddo, no pixel e no display verde. A interface parece nascida entre 1984 e 2003. Se algo parece quebrado, \u00e0s vezes \u00e9 proposital: a fenda tamb\u00e9m rachou a interface."}, {"id": "readme_diegetic_companion", "label": "Companion dieg\u00e9tico", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As mini-experi\u00eancias prolongam a fic\u00e7\u00e3o de que isto \u00e9 o equipamento do agente. O app n\u00e3o substitui a mesa, o mestre nem os dados, e n\u00e3o \u00e9 um feed gamificado nem s\u00f3 um player de \u00e1udio."}, {"id": "readme_polyform_noncommercial", "label": "PolyForm Noncommercial 1.0.0", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O c\u00f3digo pode ser usado, estudado, modificado e forkado s\u00f3 para fins n\u00e3o comerciais. Redistribui\u00e7\u00e3o mant\u00e9m os avisos Required Notice e atribui o LimboOS. Uso comercial \u00e9 proibido e pede contato."}, {"id": "readme_narrative_rights", "label": "Direitos do universo narrativo", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A licen\u00e7a do c\u00f3digo n\u00e3o autoriza republicar o universo. Ficam reservados personagens, NPCs, textos inclusive sms/, lore, dossi\u00eas, intel de conte\u00fado, artes, \u00e1udios, imagens, a marca e o nome LimboOS. Depend\u00eancias npm seguem as licen\u00e7as delas."}, {"id": "readme_license_file", "label": "LICENSE", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arquivo de licen\u00e7a do reposit\u00f3rio, citado como sede dos avisos Required Notice."}, {"id": "readme_xxinous", "label": "xXinous", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contato para uso comercial, via issues ou perfil em github.com/xXinous."}, {"id": "readme_npc_joe", "label": "Joe", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC de SMS da cidade."}, {"id": "readme_npc_mai", "label": "Mai", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC de SMS da cidade."}, {"id": "readme_npc_nil", "label": "Nil", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC de SMS da cidade."}, {"id": "readme_npc_bocao", "label": "Boc\u00e3o", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC de SMS da cidade."}, {"id": "readme_npc_jaden", "label": "Jaden", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC de SMS da cidade."}], "edges": [{"source": "readme_limboos", "target": "readme_agente", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_limboos", "target": "readme_mestre", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_limboos", "target": "readme_limbo", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_limboos", "target": "readme_intel", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "READM