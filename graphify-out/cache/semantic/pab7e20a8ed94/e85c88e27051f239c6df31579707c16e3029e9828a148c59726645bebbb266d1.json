{"nodes": [{"id": "sms_sms_do_joe_joe", "label": "Joe", "file_type": "concept", "source_file": "sms/sms do joe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPC guitarrista. Prefere 2003, com cifra na internet e pedaleira barata, e n\u00e3o quer voltar a 2000."}, {"id": "sms_sms_do_joe_swallow_rest", "label": "Swallow Rest", "file_type": "concept", "source_file": "sms/sms do joe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cidade cuja f\u00edsica Joe diz limpar ru\u00eddo e cuja fia\u00e7\u00e3o ele mede no por\u00e3o."}, {"id": "sms_sms_do_joe_fenda", "label": "Fenda", "file_type": "concept", "source_file": "sms/sms do joe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quebra que o mundo tenta n\u00e3o repetir, filtrando distor\u00e7\u00e3o anal\u00f3gica."}, {"id": "sms_sms_do_joe_loop_2003", "label": "Loop de 2003", "file_type": "concept", "source_file": "sms/sms do joe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ano em que o cachorro emudece e em que Joe teme que o loop engula o grupo se a banda n\u00e3o for\u00e7ar som bruto."}, {"id": "sms_sms_do_joe_som_esteril", "label": "Som est\u00e9ril", "file_type": "rationale", "source_file": "sms/sms do joe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O amplificador valvulado n\u00e3o distorce mesmo no ganho m\u00e1ximo: o ar rejeita sujeira anal\u00f3gica. Joe l\u00ea a f\u00edsica de Swallow Rest limpando qualquer ru\u00eddo que possa causar outra quebra na fenda."}, {"id": "sms_sms_do_joe_silencio_vizinhanca", "label": "Sil\u00eancio da vizinhan\u00e7a", "file_type": "concept", "source_file": "sms/sms do joe.md", "source_location": null, "s